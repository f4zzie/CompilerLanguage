{
  "version": 2,
  "configurePresets": [
    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "KITE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-asan",
      "displayName": "Linux Debug with sanitizers",
      "inherits": "linux-debug",
      "binaryDir": "${sourceDir}/build/linux-asan",
      "cacheVariables": { "KITE_ENABLE_SANITIZERS": "ON" }
    },
    {
      "name": "release",
      "displayName": "Portable Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "KITE_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "linux-debug", "configurePreset": "linux-debug" },
    { "name": "linux-asan", "configurePreset": "linux-asan" },
    { "name": "release", "configurePreset": "release" }
  ]
}
